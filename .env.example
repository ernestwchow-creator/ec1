# Google OAuth2 credentials
# 1. Go to https://console.cloud.google.com/
# 2. Create a project (or select an existing one)
# 3. Enable the Google Docs API: APIs & Services > Enable APIs > search "Google Docs API"
# 4. Create OAuth credentials: APIs & Services > Credentials > Create Credentials > OAuth client ID
#    - Application type: Web application
#    - Authorized redirect URI: <BASE_URL>/auth/callback
#      e.g. http://localhost:3000/auth/callback for local development,
#           https://your-app.onrender.com/auth/callback once deployed
# 5. Copy the Client ID and Client Secret below

GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# API key used by the Google Picker (the "Browse Google Drive" button).
# Google Cloud console > APIs & Services > Credentials > Create credentials >
# API key. Restrict it to the Picker API and to your app's domain.
# Leave unset to hide the browse button; pasting a URL still works.
# GOOGLE_API_KEY=your_api_key_here

# Optional. Your Cloud project *number* (not the ID), from the console's
# project settings. Picker uses it to link picked files to this app.
# GOOGLE_PROJECT_NUMBER=123456789012

# Random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_this_to_a_random_string

# The public origin the app is served from. Leave unset for local development.
# Set this to your https URL when deploying — the OAuth redirect is derived from
# it, and it must match the redirect URI registered in Google Cloud exactly.
# BASE_URL=https://your-app.onrender.com

PORT=3000
